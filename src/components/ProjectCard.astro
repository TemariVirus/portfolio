---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    title: string;
    img: ImageMetadata;
    link: string;
}

const { title, img, link } = Astro.props;
---

<style>
    .card {
        background-color: #2e2e2e;
        padding: 16px;
        border-radius: 16px;
        border: 3px solid #b8860b;
    }
    .card:hover {
        border-color: #faebd7;
        transform: translateY(-4px);
        transition:
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    a {
        text-decoration: none;
    }
    a:hover {
        font-weight: 600;
    }

    h3 {
        margin-top: 0.5rem;
        font-size: 1.25rem;
    }
</style>
<a href={link} class="block card" aria-label={title}>
    <Picture src={img} alt="Title card" layout="full-width" />

    <h3 class="line-clamp-2">{title}</h3>
</a>
