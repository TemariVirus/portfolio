---
const base_url = import.meta.env.BASE_URL;
---

<style>
    header {
        display: flex;
        flex-direction: row;
        min-width: fit-content;
        width: 100%;
        margin: 0;
        padding: 0.5rem 0;

        color: #000000;
        background-color: #beb7a4;
    }

    nav {
        display: flex;
        width: 100%;
        max-width: var(--blog-width);
        padding: 0 var(--blog-pad);
        margin: 0 auto;
        gap: 16px;
    }

    nav > *:first-child {
        margin-right: auto;
    }

    nav a {
        padding: 0 4px;
    }
    nav a:hover {
        text-decoration: underline;
        font-weight: 600;
    }
</style>
<header>
    <nav>
        <a href={base_url}><b>TEMARI VÍRUS</b></a>
        <a href={base_url + "blog"}>Blog</a>
        <a href={base_url + "contact"}>Contact</a>
    </nav>
</header>
